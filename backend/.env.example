# Formwise backend
FORMWISE_ENVIRONMENT=development
FORMWISE_DATABASE_URL=sqlite:///./formwise.db
FORMWISE_STORAGE_ROOT=./private_storage
FORMWISE_MAX_UPLOAD_SIZE_BYTES=10485760

# Phase 2 temporary identity adapter.
# Never treat a client-supplied X-User-ID as production authentication.
# Verified session/JWT authentication replaces this adapter in the auth phase.
